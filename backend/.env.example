# Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=healthcare_db

# JWT Secret (nên đặt chuỗi ngẫu nhiên dài khi deploy production)
JWT_SECRET=change-this-to-a-strong-random-secret-key
JWT_EXPIRE_HOURS=168

# CORS (danh sách domain frontend cách nhau bởi dấu phẩy, hoặc * khi dev)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI API Keys (nên cấu hình ít nhất 1 provider)
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2
OPENROUTER_API_KEY=your_openrouter_api_key
GROQ_API_KEY=your_groq_api_key

# SMTP Email (dùng cho cảnh báo SOS & Giám sát AI; nếu để trống sẽ chạy chế độ mô phỏng)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Bật mock phân tích dinh dưỡng cho demo (true/false)
ENABLE_DEMO_MOCK=false
